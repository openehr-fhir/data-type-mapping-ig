Instance: fhir-to-openehr-model
InstanceOf: ConceptMap
Usage: #definition
Title: "FHIR elements to openEHR logical models"
Description: "Independently authored reverse conceptual correspondences from FHIR R5 snapshots to the pinned openEHR logical models, including one-way and contextual gaps rather than mechanically reversing the forward map."
* insert ModelConceptMapMetadata(fhir-to-openehr-model, FHIRToOpenEHRModel)

* insert FHIRModelGroup(boolean, DV-BOOLEAN)
* insert ModelElement(boolean, DV_BOOLEAN, lossless, open, datatype, mapping-boolean, [[Only a present boolean becomes a DV_BOOLEAN; absence reasons are handled separately.]])
* insert ModelElement(boolean.value, DV_BOOLEAN.value, lossless, open, datatype, mapping-boolean, [[Do not invent a mandatory openEHR value for an absent FHIR primitive.]])

* insert FHIRModelGroup(Quantity, DV-QUANTITY)
* insert ModelElement(Quantity, DV_QUANTITY, lossy, open, datatype, mapping-quantity, [[The ad comparator has no faithful representation and percentage accuracy can be ambiguous. Missing mandatory magnitude/units prevent construction.]])
* insert ModelElement(Quantity.value, DV_QUANTITY.magnitude, lossless, settled, datatype, mapping-quantity, [[A present numeric magnitude; no zero or other default is substituted when absent.]])
* insert ModelElement(Quantity.code, DV_QUANTITY.units, lossless, settled, datatype, mapping-quantity, [[A present computable unit; missing units are not fabricated.]])
* insert ModelElement(Quantity.system, DV_QUANTITY.units-system, lossless, settled, datatype, mapping-quantity, [[The unit system, including an explicit UCUM system introduced by the forward normalization.]])
* insert ModelElement(Quantity.unit, DV_QUANTITY.units-display-name, lossless, settled, datatype, mapping-quantity, [[The human-readable unit text.]])
* insert ModelElement(Quantity.comparator, DV_QUANTITY.magnitude-status, lossless, settled, datatype, mapping-quantity, [[Less/greater comparators correspond directly; an absent comparator represents equality. R5 ad is excluded.]])
* insert ModelCondition([[Comparator is <, <=, > or >=; no ad correspondence is asserted.]])
* insert FHIRExtensionGroup(quantity-precision, DV-QUANTITY)
* insert ModelElement(Extension.value[x], DV_QUANTITY.precision, lossless, settled, datatype, mapping-quantity, [[Use the most granular precision available. An absent extension corresponds to unlimited (-1); placement on Quantity/SimpleQuantity or Money.value is supplied by context.]])
* insert FHIRExtensionGroup(quantity-accuracy, DV-QUANTITY)
* insert ModelElement(Extension.value[x], DV_QUANTITY.accuracy, lossless, open, datatype, mapping-quantity, [[The accuracy Quantity supplies the magnitude, with its unit interpreted using the parent quantity.]])
* insert ModelElement(Extension.value[x].code, DV_QUANTITY.accuracy-is-percent, lossless, open, datatype, mapping-quantity, [[UCUM % marks relative accuracy only when the parent quantity's own unit is not %. Otherwise the flag is not inferred.]])
* insert ModelCondition([[The parent magnitude's unit is not %.]])
* insert FHIRModelGroup(Observation, DV-QUANTITY)
* insert ModelElement(Observation.referenceRange, DV_QUANTITY.normal-range, lossless, settled, archetype, mapping-quantity, [[The normal reference range; resource/archetype context identifies the receiving quantity.]])
* insert ModelCondition([[referenceRange.type is normal.]])
* insert ModelTarget(DV_QUANTITY.other-reference-ranges, lossless, settled, archetype, mapping-quantity, [[Other meanings become REFERENCE_RANGE.meaning.]])
* insert ModelCondition([[referenceRange.type is not normal.]])
* insert ModelElement(Observation.interpretation, DV_QUANTITY.normal-status, lossy, open, archetype, mapping-quantity, [[The required openEHR normal_statuses binding cannot carry the wider FHIR vocabulary. Codes outside that set are not preserved; H/L/N have separate terminology maps.]])

* insert FHIRModelGroup(Count, DV-COUNT)
* insert ModelElement(Count, DV_COUNT, lossy, open, datatype, mapping-quantity, [[The table's aggregate verdict includes fixed UCUM system/code with no openEHR attributes; reference/interpretation context is separate.]])
* insert ModelElement(Count.value, DV_COUNT.magnitude, lossless, settled, datatype, mapping-quantity, [[A present whole number in the openEHR integer range; do not fabricate a missing magnitude.]])
* insert ModelElement(Count.comparator, DV_COUNT.magnitude-status, lossless, settled, datatype, mapping-quantity, [[The shared comparator correspondence; ad has no faithful counterpart.]])
* insert UnmappedModelElement(Count.system, [[The UCUM constant is not an openEHR field; settled. See mapping-quantity.]])
* insert UnmappedModelElement(Count.code, [[The UCUM code 1 is not an openEHR field; settled. See mapping-quantity.]])
* insert FHIRModelGroup(Observation, DV-COUNT)
* insert ModelElement(Observation.referenceRange, DV_COUNT.normal-range, lossless, settled, archetype, mapping-quantity, [[The normal reference range, selected by its type.]])
* insert ModelCondition([[referenceRange.type is normal.]])
* insert ModelTarget(DV_COUNT.other-reference-ranges, lossless, settled, archetype, mapping-quantity, [[Other reference-range meanings follow the same inherited pattern.]])
* insert ModelCondition([[referenceRange.type is not normal.]])
* insert ModelElement(Observation.interpretation, DV_COUNT.normal-status, lossy, open, archetype, mapping-quantity, [[Interpretation codes outside the required normal_statuses set are lost.]])

* insert FHIRModelGroup(Ratio, DV-PROPORTION)
* insert UnmappedModelElement(Ratio, [[No DV_PROPORTION is constructed: mandatory type cannot be sourced from Ratio; open, FHIR-56001. See mapping-quantity.]])
* insert UnmappedModelElement(Ratio.numerator, [[The numerator alone cannot construct a proportion without its mandatory kind; settled. See mapping-quantity.]])
* insert UnmappedModelElement(Ratio.denominator, [[The denominator is not used to invent a proportion kind; settled. See mapping-quantity.]])
* insert FHIRExtensionGroup(quantity-precision, DV-PROPORTION)
* insert UnmappedModelElement(Extension.value[x], [[No proportion is constructed, so precision has no receiving value; open, FHIR-56001. See mapping-quantity.]])
* insert FHIRExtensionGroup(rendered-value, DV-PROPORTION)
* insert UnmappedModelElement(Extension.value[x], [[Rendering does not identify a unique proportion kind; open, working-group. See mapping-quantity.]])

* insert FHIRModelGroup(Range, DV-INTERVAL)
* insert ModelElement(Range, DV_INTERVAL, lossy, settled, datatype, mapping-quantity, [[Choose a numeric type parameter from context; missing bounds indicate unboundedness and exclusivity is not carried. No bound IDs exist in the pinned DV_INTERVAL snapshot.]])
* insert FHIRModelGroup(Period, DV-INTERVAL)
* insert ModelElement(Period, DV_INTERVAL, lossy, settled, datatype, mapping-quantity, [[Choose the temporal type parameter from context; the inclusive-bound convention is not a carried openEHR flag. Bound attributes cannot be coded against this incomplete base snapshot.]])
* insert FHIRModelGroup(Quantity, DV-INTERVAL)
* insert ModelElement(Quantity, DV_INTERVAL, lossy, settled, datatype, mapping-quantity, [[A comparator quantity represents one bound of an interval, not a second numeric type chosen automatically. No bound element IDs are invented.]])
* insert ModelCondition([[The archetype chooses a one-sided interval representation and the comparator denotes the appropriate bound.]])

* insert FHIRModelGroup(Money, DV-QUANTITY)
* insert ModelElement(Money, DV_QUANTITY, lossy, open, datatype, mapping-quantity, [[Money cannot carry magnitude status, accuracy, reference ranges or normal status. A present amount and currency become an ISO 4217 quantity.]])
* insert ModelElement(Money.value, DV_QUANTITY.magnitude, lossless, open, datatype, mapping-quantity, [[The monetary amount; an absent mandatory source value is not invented.]])
* insert ModelElement(Money.currency, DV_QUANTITY.units, lossless, open, datatype, mapping-quantity, [[The ISO 4217 currency code.]])
* insert ModelTarget(DV_QUANTITY.units-system, lossless, open, datatype, mapping-quantity, [[The required currency binding entails urn:iso:std:iso:4217; the source has no separate system field.]])
* insert FHIRExtensionGroup(rendered-value, DV-QUANTITY)
* insert ModelElement(Extension.value[x], DV_QUANTITY.units-display-name, lossless, open, datatype, mapping-quantity, [[The display form of a Money currency, not the rendered text of an arbitrary value.]])
* insert ModelCondition([[The extension is on Money.currency.]])
* insert FHIRModelGroup(SimpleQuantity, DV-QUANTITY)
* insert ModelElement(Quantity, DV_QUANTITY, lossy, open, datatype, mapping-quantity, [[SimpleQuantity uses Quantity IDs. No comparator, normal status or reference-range field arrives through this mapping.]])
* insert ModelElement(Quantity.value, DV_QUANTITY.magnitude, lossless, settled, datatype, mapping-quantity, [[A present numeric magnitude.]])
* insert ModelElement(Quantity.code, DV_QUANTITY.units, lossless, settled, datatype, mapping-quantity, [[A present unit code.]])
* insert ModelElement(Quantity.system, DV_QUANTITY.units-system, lossless, settled, datatype, mapping-quantity, [[The unit system.]])
* insert ModelElement(Quantity.unit, DV_QUANTITY.units-display-name, lossless, settled, datatype, mapping-quantity, [[The unit display text.]])

* insert FHIRModelGroup(MoneyQuantity, DV-QUANTITY)
* insert ModelElement(Quantity, DV_QUANTITY, lossy, open, datatype, mapping-quantity, [[MoneyQuantity follows Quantity, not Money: comparator/accuracy remain possible, with the same ad and percentage-accuracy gaps.]])
* insert ModelElement(Quantity.value, DV_QUANTITY.magnitude, lossless, settled, datatype, mapping-quantity, [[The present monetary magnitude.]])
* insert ModelElement(Quantity.code, DV_QUANTITY.units, lossless, settled, datatype, mapping-quantity, [[The ISO 4217 currency code.]])
* insert ModelElement(Quantity.system, DV_QUANTITY.units-system, lossless, settled, datatype, mapping-quantity, [[The ISO 4217 system of the currency-constrained Quantity.]])
* insert ModelElement(Quantity.unit, DV_QUANTITY.units-display-name, lossless, settled, datatype, mapping-quantity, [[The currency display text.]])
* insert ModelElement(Quantity.comparator, DV_QUANTITY.magnitude-status, lossless, settled, datatype, mapping-quantity, [[The supported Quantity comparator correspondence, excluding ad.]])

* insert FHIRModelGroup(Observation, DV-ORDINAL)
* insert ModelElement(Observation.component, DV_ORDINAL, lossy, open, archetype, mapping-quantity, [[An archetype associates symbol/score components. The wider interpretation vocabulary cannot all become normal_status; this is not a standalone component conversion.]])
* insert ModelElement(Observation.component.value[x], DV_ORDINAL.symbol, lossless, settled, archetype, mapping-quantity, [[The CodeableConcept alternative supplies the coded symbol through the DV_CODED_TEXT correspondence.]])
* insert ModelCondition([[The component is the symbol component and value[x] is CodeableConcept.]])
* insert ModelTarget(DV_ORDINAL.value, lossless, settled, archetype, mapping-quantity, [[The integer alternative supplies the ordinal score, not the coded symbol.]])
* insert ModelCondition([[The component is the score component and value[x] is integer.]])
* insert ModelElement(Observation.referenceRange, DV_ORDINAL.normal-range, lossless, settled, archetype, mapping-quantity, [[The normal reference range under the enclosing archetype.]])
* insert ModelCondition([[referenceRange.type is normal.]])
* insert ModelTarget(DV_ORDINAL.other-reference-ranges, lossless, settled, archetype, mapping-quantity, [[Other reference-range meanings follow the same inherited ordered-value pattern.]])
* insert ModelCondition([[referenceRange.type is not normal.]])
* insert ModelElement(Observation.interpretation, DV_ORDINAL.normal-status, lossy, open, archetype, mapping-quantity, [[Interpretation codes outside the required normal_statuses set are not carried.]])
* insert FHIRModelGroup(QuestionnaireResponse, DV-ORDINAL)
* insert ModelElement(QuestionnaireResponse.item.answer.value[x], DV_ORDINAL.symbol, lossless, settled, archetype, mapping-quantity, [[The Coding answer alternative supplies the symbol, not every possible answer type.]])
* insert ModelCondition([[value[x] is Coding and the item represents the ordinal symbol.]])
* insert FHIRExtensionGroup(itemWeight, DV-ORDINAL)
* insert ModelElement(Extension.value[x], DV_ORDINAL.value, lossless, settled, archetype, mapping-quantity, [[The score is on the coded symbol; the archetype associates the weight with its symbol and requires an integral ordinal score.]])
* insert ModelCondition([[An integral weight associated with the ordinal's coded symbol.]])
* insert FHIRModelGroup(Observation, DV-SCALE)
* insert ModelElement(Observation.component, DV_SCALE, lossy, open, archetype, mapping-quantity, [[An archetype associates the symbol and real score; wider interpretation codes can be lost.]])
* insert ModelElement(Observation.component.value[x], DV_SCALE.symbol, lossless, settled, archetype, mapping-quantity, [[The CodeableConcept alternative supplies the symbol.]])
* insert ModelCondition([[The component is the symbol component and value[x] is CodeableConcept.]])
* insert ModelTarget(DV_SCALE.value, lossless, settled, archetype, mapping-quantity, [[The Quantity alternative supplies the real-valued score, not an integer-only score.]])
* insert ModelCondition([[The component is the score component and value[x] is Quantity.]])
* insert ModelElement(Observation.referenceRange, DV_SCALE.normal-range, lossless, settled, archetype, mapping-quantity, [[The shared ordered-value reference-range pattern.]])
* insert ModelCondition([[referenceRange.type is normal.]])
* insert ModelTarget(DV_SCALE.other-reference-ranges, lossless, settled, archetype, mapping-quantity, [[Other reference-range meanings follow the same inherited pattern.]])
* insert ModelCondition([[referenceRange.type is not normal.]])
* insert ModelElement(Observation.interpretation, DV_SCALE.normal-status, lossy, open, archetype, mapping-quantity, [[Interpretation codes outside the required normal_statuses set are lost.]])
* insert FHIRExtensionGroup(itemWeight, DV-SCALE)
* insert ModelElement(Extension.value[x], DV_SCALE.value, lossless, settled, archetype, mapping-quantity, [[Alternative: the real-valued score is carried as a weight on the coded symbol.]])

* insert FHIRModelGroup(Coding, CODE-PHRASE)
* insert ModelElement(Coding, CODE_PHRASE, lossy, open, datatype, mapping-coded, [[Version and userSelected have no carried fields. An absent code prevents construction; absent-system handling remains an explicit open policy.]])
* insert ModelElement(Coding.system, CODE_PHRASE.terminology-id, lossless, open, datatype, mapping-coded, [[The opaque system identifier when present. This does not choose a system-plus-version join format or a missing-system default.]])
* insert ModelElement(Coding.code, CODE_PHRASE.code-string, lossless, open, datatype, mapping-coded, [[A present code string; absence is not repaired with a fabricated mandatory code.]])
* insert ModelElement(Coding.display, CODE_PHRASE.preferred-term, lossless, settled, datatype, mapping-coded, [[The display becomes the preferred term.]])
* insert UnmappedModelElement(Coding.version, [[No system/version join convention is adopted; open, working-group. See mapping-coded.]])
* insert FHIRModelGroup(CodeableConcept, DV-CODED-TEXT)
* insert ModelElement(CodeableConcept, DV_CODED_TEXT, lossy, open, datatype, mapping-coded, [[Version, userSelected and defining-code distinctions can be lost; additional codings need unknown TERM_MAPPING.match rather than invented equivalence.]])
* insert ModelElement(CodeableConcept.text, DV_CODED_TEXT.value, lossless, settled, datatype, mapping-coded, [[A missing text/display requires rubric resolution from the code; no empty mandatory text is invented.]])
* insert ModelElement(CodeableConcept.coding, DV_CODED_TEXT.defining-code, lossy, settled, datatype, mapping-coded, [[Choose using template terminology, then userSelected, then the documented reported fallback. userSelected and Coding.version are not preserved.]])
* insert ModelCondition([[This is the coding selected as defining; several unmarked codings additionally lose which one was defining.]])
* insert ModelTarget(DV_CODED_TEXT.mappings, lossy, open, datatype, mapping-coded, [[Other codings become TERM_MAPPING values through the delegated correspondence; match is the RM's reported unknown (?) and purpose is not sourced.]])
* insert ModelCondition([[This is an additional coding, not the selected defining code.]])
* insert FHIRModelGroup(Coding, DV-CODED-TEXT)
* insert ModelElement(Coding, DV_CODED_TEXT, lossy, open, datatype, mapping-coded, [[The bare-Coding representation needs a code and display/rubric context. Version and userSelected are not preserved.]])
* insert ModelElement(Coding.display, DV_CODED_TEXT.value, lossless, settled, datatype, mapping-coded, [[The display supplies the text when it is the defining code's rubric in the stated language.]])
* insert ModelCondition([[The source is the bare Coding representation, with a matching rubric.]])
* insert FHIRModelGroup(Coding, TERM-MAPPING)
* insert ModelElement(Coding, TERM_MAPPING, lossy, open, datatype, mapping-coded, [[Version is lost; match cannot be sourced and becomes the reported RM unknown (?), not equivalent (=). No purpose is inferred.]])
* insert ModelElement(Coding.code, TERM_MAPPING.target, lossy, settled, datatype, mapping-coded, [[Part of the composed CODE_PHRASE target, also requiring system context; Coding.version is lost.]])
* insert UnmappedModelElement(Coding.version, [[No adopted representation in the target terminology identifier; open. See mapping-coded.]])

* insert FHIRModelGroup(Observation, ELEMENT)
* insert ModelElement(Observation.dataAbsentReason, ELEMENT.null-flavour, lossless, settled, archetype, mapping-coded, [[The absence-reason container corresponds here for Observation.value[x]; code-level semantic losses are declared in the separate terminology maps.]])
* insert FHIRExtensionGroup(data-absent-reason, ELEMENT)
* insert ModelElement(Extension.value[x], ELEMENT.null-flavour, lossless, settled, archetype, mapping-coded, [[Translate the code using the directional terminology map and construct the null-flavour DV_CODED_TEXT/rubric in the enclosing ELEMENT.]])
* insert ModelCondition([[The extension annotates the absent non-Observation value.]])
* insert FHIRExtensionGroup(iso21090-nullFlavor, ELEMENT)
* insert UnmappedModelElement(Extension.value[x], [[The RI does not consume this extension; planned terminology maps do not implement structural support; open, openehr-modelling. See mapping-coded.]])

* insert FHIRModelGroup(string, DV-TEXT)
* insert ModelElement(string, DV_TEXT, lossy, open, datatype, mapping-textual, [[BCP 47 language qualifiers and unsupported rendering instructions cannot all be preserved; source text is kept.]])
* insert ModelElement(string.value, DV_TEXT.value, lossless, settled, datatype, mapping-textual, [[A present nonempty text value; a value-less FHIR primitive does not supply mandatory DV_TEXT.value.]])
* insert FHIRModelGroup(markdown, DV-TEXT)
* insert ModelElement(markdown, DV_TEXT, lossy, open, datatype, mapping-textual, [[Markdown content is carried as DV_TEXT; the general text/language metadata limitations still apply.]])
* insert ModelTarget(DV_TEXT.formatting, lossless, open, datatype, mapping-textual, [[The native markdown datatype entails the markdown formatting choice; it is not inferred by guessing from the text.]])
* insert ModelElement(markdown.value, DV_TEXT.value, lossless, settled, datatype, mapping-textual, [[The markdown content is carried; formatting is inferred from the source datatype rather than from text alone.]])
* insert FHIRExtensionGroup(rendering-markdown, DV-TEXT)
* insert ModelElement(Extension.value[x], DV_TEXT.formatting, lossless, open, datatype, mapping-textual, [[A string with this rendering extension sets formatting to markdown; the extension is not copied literally into the formatting string.]])
* insert FHIRExtensionGroup(rendering-xhtml, DV-TEXT)
* insert UnmappedModelElement(Extension.value[x], [[No XHTML formatting value exists in DV_TEXT; the rendering instruction is lost while the underlying string text is kept; open, openehr-modelling. See mapping-textual.]])
* insert FHIRExtensionGroup(language, DV-TEXT)
* insert ModelElement(Extension.value[x], DV_TEXT.language, lossy, open, datatype, mapping-textual, [[Only ISO 639-1 primary tags fit the RM binding. Region/script subtags are lost; tags outside that code set produce no language attribute.]])
* insert FHIRModelGroup(markdown, DV-PARAGRAPH)
* insert UnmappedModelElement(markdown, [[No deprecated paragraph mapping is agreed; not-discussed, working-group. See mapping-textual.]])
* insert FHIRModelGroup(string, DV-PARAGRAPH)
* insert UnmappedModelElement(string, [[No deprecated paragraph mapping is agreed; not-discussed, working-group. See mapping-textual.]])

* insert FHIRModelGroup(Identifier, DV-IDENTIFIER)
* insert ModelElement(Identifier, DV_IDENTIFIER, lossy, open, datatype, mapping-reference, [[use/period are not carried; type is reduced to one coding and assigner to one identifier. An absent value cannot supply the mandatory id.]])
* insert ModelElement(Identifier.value, DV_IDENTIFIER.id, lossless, settled, datatype, mapping-reference, [[The present identifier value.]])
* insert ModelElement(Identifier.system, DV_IDENTIFIER.issuer, lossless, open, datatype, mapping-reference, [[Reverse the table's provisional issuer-to-URI convention; this does not settle the prefix policy.]])
* insert ModelElement(Identifier.type, DV_IDENTIFIER.type, lossy, open, datatype, mapping-reference, [[Keep one coding as system::value using the last ::. Other codings and Coding version/display/userSelected are lost.]])
* insert ModelElement(Identifier.assigner, DV_IDENTIFIER.assigner, lossy, open, datatype, mapping-reference, [[Read assigner.identifier or the referenced Organization identifier; other Reference fields are lost.]])
* insert UnmappedModelElement(Identifier.use, [[No datatype attribute; an extended cluster archetype is separate work; open, openehr-modelling. See mapping-reference.]])
* insert UnmappedModelElement(Identifier.period, [[No datatype attribute; historic distinctions carried only by period are lost; open, openehr-modelling. See mapping-reference.]])
* insert FHIRModelGroup(uri, DV-URI)
* insert ModelElement(uri, DV_URI, lossy, open, datatype, mapping-reference, [[The combined URI table has an aggregate lossy verdict; a valid received URI is carried without decoding it into a guessed original plain-text form.]])
* insert ModelElement(uri.value, DV_URI.value, lossless, open, datatype, mapping-reference, [[Carry the URI verbatim, including existing percent escapes.]])
* insert FHIRModelGroup(url, DV-URI)
* insert ModelElement(url.value, DV_URI.value, lossless, open, datatype, mapping-reference, [[A received URL is a URI; its resolution semantics do not create an RM subtype.]])
* insert FHIRModelGroup(oid, DV-URI)
* insert ModelElement(oid.value, DV_URI.value, lossless, open, datatype, mapping-reference, [[The urn:oid: URI is retained.]])
* insert FHIRModelGroup(uuid, DV-URI)
* insert ModelElement(uuid.value, DV_URI.value, lossless, open, datatype, mapping-reference, [[The lowercase urn:uuid: URI is retained.]])
* insert FHIRModelGroup(canonical, DV-URI)
* insert ModelElement(canonical.value, DV_URI.value, lossless, open, datatype, mapping-reference, [[The canonical URL and optional version suffix are retained as the documented URI representation.]])
* insert FHIRModelGroup(uri, DV-EHR-URI)
* insert ModelElement(uri.value, DV_EHR_URI.value, lossless, open, datatype, mapping-reference, [[Only an ehr: URI belongs in this RM subtype; arbitrary FHIR URIs are not reclassified as EHR locators.]])
* insert ModelCondition([[The URI is an openEHR ehr: locator.]])
* insert FHIRModelGroup(Reference, LINK)
* insert UnmappedModelElement(Reference, [[Mandatory LINK.type cannot be sourced from a bare Reference; open, openehr-modelling. See mapping-reference.]])
* insert UnmappedModelElement(Reference.identifier, [[No LINK is constructed without mandatory type; open. See mapping-reference.]])
* insert UnmappedModelElement(Reference.reference, [[No LINK is constructed without mandatory type or record-conversion context; open. See mapping-reference.]])
* insert UnmappedModelElement(Reference.display, [[No LINK is constructed; its mandatory type is absent; open. See mapping-reference.]])
* insert UnmappedModelElement(Reference.type, [[Resource type is not an RM link relationship; no LINK field corresponds; settled. See mapping-reference.]])
* insert FHIRModelGroup(CodeableReference, LINK)
* insert UnmappedModelElement(CodeableReference, [[The coded concept and link require a split/enclosing archetype, not a single datatype conversion; open, openehr-modelling. See mapping-reference.]])
* insert UnmappedModelElement(CodeableReference.concept, [[This guide defines no reverse LINK.type conversion from the combined value; open. See mapping-reference.]])
* insert FHIRModelGroup(Reference, PARTY-IDENTIFIED)
* insert UnmappedModelElement(Reference, [[The target role cannot be decided from a Reference alone; open, openehr-modelling. See mapping-reference.]])

* insert FHIRModelGroup(date, DV-DATE)
* insert ModelElement(date, DV_DATE, lossless, settled, datatype, mapping-temporal, [[Retain the stated partial date precision; never supply an omitted month or day.]])
* insert ModelElement(date.value, DV_DATE.value, lossless, settled, datatype, mapping-temporal, [[The date lexical value with the same precision.]])
* insert FHIRModelGroup(dateTime, DV-DATE)
* insert ModelElement(dateTime.value, DV_DATE.value, lossless, settled, datatype, mapping-temporal, [[Only a date-only dateTime belongs in this correspondence; a time of day is not silently discarded.]])
* insert ModelCondition([[The source dateTime carries only a date.]])
* insert FHIRModelGroup(time, DV-TIME)
* insert ModelElement(time, DV_TIME, lossy, open, datatype, mapping-temporal, [[The value has no offset; fractional precision beyond RM milliseconds is lost.]])
* insert ModelElement(time.value, DV_TIME.value, lossy, settled, datatype, mapping-temporal, [[Truncate fractional seconds beyond three digits; no UTC offset can be recovered from a time value.]])
* insert FHIRModelGroup(dateTime, DV-DATE-TIME)
* insert ModelElement(dateTime, DV_DATE_TIME, lossy, open, datatype, mapping-temporal, [[The table's aggregate includes temporal metadata with no primitive home; a present date/time value maps with its stated precision and offset.]])
* insert ModelElement(dateTime.value, DV_DATE_TIME.value, lossless, settled, datatype, mapping-temporal, [[The stated date/time, offset and supported partial precision; no previously padded source precision can be recovered.]])
* insert FHIRModelGroup(instant, DV-DATE-TIME)
* insert ModelElement(instant.value, DV_DATE_TIME.value, lossless, settled, datatype, mapping-temporal, [[A fully precise instant with its offset.]])
* insert FHIRModelGroup(Duration, DV-DURATION)
* insert ModelElement(Duration, DV_DURATION, lossy, open, datatype, mapping-temporal, [[The millisecond unit form normalizes to seconds, ad has no faithful comparator, and interpretation/reference information is contextual.]])
* insert ModelElement(Duration.value, DV_DURATION.value, lossless, open, datatype, mapping-temporal, [[Combine the magnitude with its UCUM unit into one ISO component, preserving the sign before P. Calendar arithmetic is not an equivalence between ISO calendar units and UCUM units.]])
* insert ModelCondition([[A present magnitude and a supported unit a, mo, wk, d, h, min or s; the millisecond-form normalization is a separate table gap.]])
* insert ModelElement(Duration.code, DV_DURATION.value, lossless, settled, datatype, mapping-temporal, [[The supported UCUM code supplies the ISO designator inside the same value string; it is not a separate RM attribute.]])
* insert ModelCondition([[Unit is a, mo, wk, d, h, min or s.]])
* insert ModelElement(Duration.comparator, DV_DURATION.magnitude-status, lossless, settled, datatype, mapping-temporal, [[The shared comparator correspondence, excluding ad; absence denotes equality.]])
* insert UnmappedModelElement(Duration.system, [[The fixed UCUM system is not a separate RM duration attribute; see mapping-temporal.]])
* insert FHIRExtensionGroup(quantity-accuracy, DV-DURATION)
* insert ModelElement(Extension.value[x], DV_DURATION.accuracy, lossless, open, datatype, mapping-temporal, [[The accuracy Quantity supplies its magnitude.]])
* insert ModelElement(Extension.value[x].code, DV_DURATION.accuracy-is-percent, lossless, open, datatype, mapping-temporal, [[UCUM % indicates relative accuracy; a duration's own unit is a time unit, not %.]])
* insert FHIRModelGroup(Observation, DV-DURATION)
* insert ModelElement(Observation.referenceRange, DV_DURATION.normal-range, lossless, settled, archetype, mapping-temporal, [[The normal reference range under the enclosing archetype.]])
* insert ModelCondition([[referenceRange.type is normal.]])
* insert ModelTarget(DV_DURATION.other-reference-ranges, lossless, settled, archetype, mapping-temporal, [[Other reference-range meanings supply the RM meaning.]])
* insert ModelCondition([[referenceRange.type is not normal.]])
* insert ModelElement(Observation.interpretation, DV_DURATION.normal-status, lossy, open, archetype, mapping-temporal, [[Codes outside the required normal_statuses set are lost.]])
* insert FHIRModelGroup(Timing, DV-DURATION)
* insert UnmappedModelElement(Timing.repeat, [[Complex scheduling is deferred; open, working-group. See mapping-temporal.]])
* insert FHIRModelGroup(Timing, DV-GENERAL-TIME-SPECIFICATION)
* insert UnmappedModelElement(Timing, [[No GTS conversion is agreed; not-discussed, working-group. See mapping-temporal.]])
* insert FHIRModelGroup(Timing, DV-PERIODIC-TIME-SPECIFICATION)
* insert UnmappedModelElement(Timing, [[No periodic conversion is agreed; not-discussed, working-group. See mapping-temporal.]])

* insert FHIRModelGroup(Attachment, DV-MULTIMEDIA)
* insert ModelElement(Attachment, DV_MULTIMEDIA, lossy, open, datatype, mapping-other, [[Creation/dimensions/frames/duration/pages have no datatype attributes, wider language tags lose detail, and additional or incompatible thumbnails are not carried. Required contentType/size must be present and fit RM constraints.]])
* insert ModelElement(Attachment.data, DV_MULTIMEDIA.data, lossless, open, datatype, mapping-other, [[The content bytes arrive uncompressed; compression metadata from an earlier source cannot be recovered.]])
* insert ModelElement(Attachment.url, DV_MULTIMEDIA.uri, lossless, open, datatype, mapping-other, [[The URL is retained; an original plain-text URI is not guessed by decoding it.]])
* insert ModelElement(Attachment.contentType, DV_MULTIMEDIA.media-type, lossless, open, datatype, mapping-other, [[Extract the MIME media type; a missing required type is not invented.]])
* insert ModelTarget(DV_MULTIMEDIA.charset, lossless, settled, datatype, mapping-other, [[Extract a supplied charset MIME parameter into the inherited charset attribute; do not invent one when absent.]])
* insert ModelCondition([[The contentType contains a charset parameter.]])
* insert ModelElement(Attachment.size, DV_MULTIMEDIA.size, lossless, open, datatype, mapping-other, [[Read integer64 from its JSON string form; an out-of-range or missing mandatory size prevents construction, not truncation.]])
* insert ModelCondition([[Size is present and within the RM 32-bit Integer range.]])
* insert ModelElement(Attachment.title, DV_MULTIMEDIA.alternate-text, lossless, open, datatype, mapping-other, [[Alternative display text.]])
* insert ModelElement(Attachment.hash, DV_MULTIMEDIA.integrity-check, lossless, open, datatype, mapping-other, [[The SHA-1 bytes are carried only when no alternate-hash takes precedence.]])
* insert ModelCondition([[There is no alternate-hash alongside hash.]])
* insert ModelTarget(DV_MULTIMEDIA.integrity-check-algorithm, lossless, open, datatype, mapping-other, [[Attachment.hash entails SHA-1; the source element definition supplies the algorithm, not a guessed default.]])
* insert ModelCondition([[There is no alternate-hash alongside hash.]])
* insert ModelElement(Attachment.language, DV_MULTIMEDIA.language, lossy, open, datatype, mapping-other, [[Only ISO 639-1 primary tags fit the RM binding. Region/script subtags are lost; out-of-code-set tags produce no language.]])
* insert UnmappedModelElement(Attachment.creation, [[No multimedia datatype attribute; extension-archetype work is separate; open, openehr-modelling. See mapping-other.]])
* insert UnmappedModelElement(Attachment.height, [[No multimedia datatype attribute; open, openehr-modelling. See mapping-other.]])
* insert UnmappedModelElement(Attachment.width, [[No multimedia datatype attribute; open, openehr-modelling. See mapping-other.]])
* insert UnmappedModelElement(Attachment.frames, [[No multimedia datatype attribute; open, openehr-modelling. See mapping-other.]])
* insert UnmappedModelElement(Attachment.duration, [[No multimedia datatype attribute; open, openehr-modelling. See mapping-other.]])
* insert UnmappedModelElement(Attachment.pages, [[No multimedia datatype attribute; open, openehr-modelling. See mapping-other.]])
* insert FHIRExtensionGroup(alternate-hash, DV-MULTIMEDIA)
* insert ModelElement(Extension.extension:hash.value[x], DV_MULTIMEDIA.integrity-check, lossless, open, datatype, mapping-other, [[Read the documented base64 representation of the alternate hash; this takes precedence over a simultaneous Attachment.hash.]])
* insert ModelElement(Extension.extension:algorithm.value[x], DV_MULTIMEDIA.integrity-check-algorithm, lossless, open, datatype, mapping-other, [[The explicitly stated algorithm accompanies the alternate hash.]])
* insert FHIRExtensionGroup(attachment-thumbnail, DV-MULTIMEDIA)
* insert ModelElement(Extension.value[x], DV_MULTIMEDIA.thumbnail, lossless, open, datatype, mapping-other, [[Convert the first thumbnail through Attachment to DV_MULTIMEDIA. Additional thumbnails and a non-convertible thumbnail are omitted and reported, not silently synthesized.]])
* insert ModelCondition([[The first thumbnail has convertible content and all mandatory RM attributes.]])
* insert FHIRExtensionGroup(attachment-isThumbnail, DV-MULTIMEDIA)
* insert UnmappedModelElement(Extension.value[x], [[No multimedia flag corresponds; the containment in attachment-thumbnail already states the role; open, openehr-modelling. See mapping-other.]])
* insert FHIRModelGroup(string, DV-PARSABLE)
* insert UnmappedModelElement(string, [[Mandatory formalism cannot be sourced from a bare string; no DV_PARSABLE is constructed; open, session:dv-parsable-formalism. See mapping-other.]])
* insert UnmappedModelElement(string.value, [[A string alone cannot supply mandatory formalism; open. See mapping-other.]])
* insert FHIRExtensionGroup(language, DV-PARSABLE)
* insert UnmappedModelElement(Extension.value[x], [[No DV_PARSABLE is constructed without a formalism, so its language has no receiver; open. See mapping-other.]])
* insert FHIRModelGroup(CodeableConcept, DV-STATE)
* insert ModelElement(CodeableConcept, DV_STATE, lossy, open, datatype, mapping-other, [[The terminal-state flag is not carried. The table records the RI's reported false inference as an explicit exception to mandatory-attribute refusal, not information supplied by CodeableConcept. The composed coded-text mapping also loses version, userSelected and mapping relationships.]])
* insert ModelTarget(DV_STATE.value, lossy, open, datatype, mapping-other, [[Delegate to DV_CODED_TEXT and retain all inner losses, including unknown TERM_MAPPING.match and ambiguous defining-code selection.]])

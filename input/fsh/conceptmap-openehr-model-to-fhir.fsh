Instance: openehr-model-to-fhir
InstanceOf: ConceptMap
Usage: #definition
Title: "openEHR logical models to FHIR elements"
Description: "Conceptual type and field correspondences from the pinned openEHR logical-model snapshots to FHIR R5 types, resources and published extensions, using their StructureDefinition implicit code systems."
* insert ModelConceptMapMetadata(openehr-model-to-fhir, OpenEHRModelToFHIR)

* insert OpenEHRModelGroup(DV-BOOLEAN, boolean)
* insert ModelElement(DV_BOOLEAN, boolean, lossless, open, datatype, mapping-boolean, [[A present boolean value; absence reasons are separate.]])
* insert ModelElement(DV_BOOLEAN.value, boolean.value, lossless, open, datatype, mapping-boolean, [[Direct true/false value correspondence.]])

* insert OpenEHRModelGroup(DV-QUANTITY, Quantity)
* insert ModelElement(DV_QUANTITY, Quantity, lossy, open, datatype, mapping-quantity, [[The table's aggregate verdict includes the unsupported approximate marker and ambiguous percentage accuracy; reference ranges and interpretation need Observation context.]])
* insert ModelElement(DV_QUANTITY.magnitude, Quantity.value, lossless, settled, datatype, mapping-quantity, [[The numeric magnitude is carried; missing mandatory source values are not invented.]])
* insert ModelElement(DV_QUANTITY.units, Quantity.code, lossless, settled, datatype, mapping-quantity, [[The computable unit code.]])
* insert ModelElement(DV_QUANTITY.units-system, Quantity.system, lossless, settled, datatype, mapping-quantity, [[Supply UCUM when absent only when the units are UCUM, as required by qty-3.]])
* insert ModelElement(DV_QUANTITY.units-display-name, Quantity.unit, lossless, settled, datatype, mapping-quantity, [[The human-readable unit label.]])
* insert ModelElement(DV_QUANTITY.magnitude-status, Quantity.comparator, lossless, settled, datatype, mapping-quantity, [[Less/greater comparators correspond directly; equality is represented by an absent comparator. Approximate (~) has no R5 mapping.]])
* insert ModelCondition([[Status is <, <=, >, >= or =; never ~.]])

* insert OpenEHRExtensionGroup(DV-QUANTITY, quantity-precision)
* insert ModelElement(DV_QUANTITY.precision, Extension.value[x], lossless, settled, datatype, mapping-quantity, [[Precision is represented by the extension on Quantity/SimpleQuantity or on Money.value; -1 is represented by absence. Extension placement is contextual.]])
* insert OpenEHRExtensionGroup(DV-QUANTITY, quantity-accuracy)
* insert ModelElement(DV_QUANTITY.accuracy, Extension.value[x], lossless, open, datatype, mapping-quantity, [[Accuracy becomes a Quantity using UCUM % for relative accuracy and the magnitude's unit otherwise.]])
* insert ModelElement(DV_QUANTITY.accuracy-is-percent, Extension.value[x].code, lossless, open, datatype, mapping-quantity, [[The accuracy Quantity's unit distinguishes relative from absolute accuracy only when the magnitude's unit is not %. The percent-unit flag remains unmapped.]])
* insert ModelCondition([[Magnitude unit is not %; this correspondence is implicit in the documented accuracy representation.]])

* insert OpenEHRModelGroup(DV-QUANTITY, Observation)
* insert ModelElement(DV_QUANTITY.normal-range, Observation.referenceRange, lossless, settled, archetype, mapping-quantity, [[The normal range has referenceRange.type = normal.]])
* insert ModelElement(DV_QUANTITY.other-reference-ranges, Observation.referenceRange, lossless, settled, archetype, mapping-quantity, [[REFERENCE_RANGE.meaning supplies a referenceRange.type other than normal.]])
* insert ModelElement(DV_QUANTITY.normal-status, Observation.interpretation, lossless, open, archetype, mapping-quantity, [[Normal status is carried at resource level; H/L/N code correspondences have separate terminology ConceptMaps.]])

* insert OpenEHRModelGroup(DV-COUNT, Count)
* insert ModelElement(DV_COUNT, Count, lossy, open, datatype, mapping-quantity, [[Aggregate table verdict: Count.system and Count.code are fixed UCUM constants, not carried openEHR attributes; reference ranges require Observation context.]])
* insert ModelElement(DV_COUNT.magnitude, Count.value, lossless, settled, datatype, mapping-quantity, [[A whole-number magnitude; Count's fixed UCUM system/code are supplied separately.]])
* insert ModelElement(DV_COUNT.magnitude-status, Count.comparator, lossless, settled, datatype, mapping-quantity, [[The Quantity comparator correspondence, excluding approximate (~); equality is absence.]])
* insert OpenEHRModelGroup(DV-COUNT, Observation)
* insert ModelElement(DV_COUNT.normal-range, Observation.referenceRange, lossless, settled, archetype, mapping-quantity, [[Normal and other reference ranges share this resource-level home; the enclosing archetype distinguishes their roles.]])
* insert ModelElement(DV_COUNT.other-reference-ranges, Observation.referenceRange, lossless, settled, archetype, mapping-quantity, [[The normal-range row covers inherited other reference ranges as well.]])
* insert ModelElement(DV_COUNT.normal-status, Observation.interpretation, lossless, open, archetype, mapping-quantity, [[Normal status uses the shared DV_ORDERED pattern.]])

* insert OpenEHRModelGroup(DV-PROPORTION, Ratio)
* insert ModelElement(DV_PROPORTION, Ratio, lossy, open, datatype, mapping-quantity, [[The kind discriminator is not carried as data. Fraction rendering does not preserve the distinction between fraction kinds.]])
* insert ModelElement(DV_PROPORTION.numerator, Ratio.numerator, lossless, settled, datatype, mapping-quantity, [[The decimal supplies the value of the numerator Quantity. Ratio.numerator.value is not an element ID in the Ratio snapshot.]])
* insert ModelElement(DV_PROPORTION.denominator, Ratio.denominator, lossless, settled, datatype, mapping-quantity, [[The decimal supplies the value of the denominator Quantity; unitary and percent kinds fix it to 1 and 100.]])
* insert UnmappedModelElement(DV_PROPORTION.type, [[Kind discriminator: no carried Ratio field; open, owner FHIR-56001. See mapping-quantity.]])
* insert OpenEHRExtensionGroup(DV-PROPORTION, quantity-precision)
* insert ModelElement(DV_PROPORTION.precision, Extension.value[x], lossless, open, datatype, mapping-quantity, [[The single precision is carried on Ratio.numerator, not separately on both quantities.]])
* insert OpenEHRExtensionGroup(DV-PROPORTION, rendered-value)
* insert ModelElement(DV_PROPORTION.type, Extension.value[x], lossy, open, datatype, mapping-quantity, [[A fraction's rendering is carried, not its kind; fraction and integer-fraction render alike when the numerator does not exceed the denominator.]])
* insert ModelCondition([[Integral fraction or integer-fraction terms; the extension is attached to Ratio.]])

* insert OpenEHRModelGroup(DV-INTERVAL, Range)
* insert ModelElement(DV_INTERVAL, Range, lossy, settled, datatype, mapping-quantity, [[Numeric interval bounds correspond to Range.low/high. Exclusive-bound flags are not preserved. The pinned DV_INTERVAL snapshot has no bound element IDs, so no field codes are invented.]])
* insert ModelCondition([[The type parameter is DV_QUANTITY or DV_COUNT.]])
* insert OpenEHRModelGroup(DV-INTERVAL, Period)
* insert ModelElement(DV_INTERVAL, Period, lossy, settled, datatype, mapping-quantity, [[Temporal bounds correspond to Period.start/end when representable as dateTime. Exclusive-bound flags are not preserved; the base snapshot has no bound element IDs.]])
* insert ModelCondition([[Temporal interval; a DV_TIME bound additionally needs surrounding date context to be a Period dateTime.]])
* insert OpenEHRModelGroup(DV-INTERVAL, Quantity)
* insert ModelElement(DV_INTERVAL, Quantity, lossy, settled, datatype, mapping-quantity, [[The one bound becomes Quantity.value and its comparator describes the boundary. The base snapshot has no bound IDs; this is a type-level correspondence only.]])
* insert ModelCondition([[Only one bound is present and the chosen representation is comparator Quantity rather than Range.]])

* insert OpenEHRModelGroup(DV-QUANTITY, Money)
* insert ModelElement(DV_QUANTITY, Money, lossy, open, datatype, mapping-quantity, [[Only ISO 4217 currency quantities qualify. Magnitude status, accuracy, reference ranges and normal status are not carried by Money.]])
* insert ModelCondition([[units_system is urn:iso:std:iso:4217; absent or other systems are refused.]])
* insert ModelElement(DV_QUANTITY.magnitude, Money.value, lossless, open, datatype, mapping-quantity, [[The monetary amount, in the ISO 4217 currency case only.]])
* insert ModelElement(DV_QUANTITY.units, Money.currency, lossless, open, datatype, mapping-quantity, [[The ISO 4217 currency code, not an arbitrary quantity unit.]])
* insert ModelElement(DV_QUANTITY.units-system, Money.currency, lossless, open, datatype, mapping-quantity, [[The ISO 4217 system is entailed by the currency binding; it is not copied into a separate Money element.]])
* insert UnmappedModelElement(DV_QUANTITY.magnitude-status, [[Money has no comparator; settled. See mapping-quantity.]])
* insert UnmappedModelElement(DV_QUANTITY.accuracy, [[Money does not carry accuracy or its percentage flag; settled. See mapping-quantity.]])
* insert UnmappedModelElement(DV_QUANTITY.normal-range, [[Money has no reference-range home in this mapping; settled. See mapping-quantity.]])
* insert UnmappedModelElement(DV_QUANTITY.other-reference-ranges, [[Money has no reference-range home in this mapping; settled. See mapping-quantity.]])
* insert UnmappedModelElement(DV_QUANTITY.normal-status, [[Money has no normal-status home in this mapping; settled. See mapping-quantity.]])
* insert OpenEHRExtensionGroup(DV-QUANTITY, rendered-value)
* insert ModelElement(DV_QUANTITY.units-display-name, Extension.value[x], lossless, open, datatype, mapping-quantity, [[The currency display form is carried by rendered-value on Money.currency.]])
* insert ModelCondition([[ISO 4217 Money representation; not Quantity.unit.]])

* insert OpenEHRModelGroup(DV-QUANTITY, SimpleQuantity)
* insert ModelElement(DV_QUANTITY, Quantity, lossy, open, datatype, mapping-quantity, [[SimpleQuantity's snapshot uses Quantity IDs. It cannot carry a comparator; normal status and reference ranges have no home in this mapping.]])
* insert ModelElement(DV_QUANTITY.magnitude, Quantity.value, lossless, settled, datatype, mapping-quantity, [[The magnitude; SimpleQuantity uses the Quantity.value ID.]])
* insert ModelElement(DV_QUANTITY.units, Quantity.code, lossless, settled, datatype, mapping-quantity, [[The computable unit code.]])
* insert ModelElement(DV_QUANTITY.units-system, Quantity.system, lossless, settled, datatype, mapping-quantity, [[The unit system, with the same conditional UCUM supply rule as Quantity.]])
* insert ModelElement(DV_QUANTITY.units-display-name, Quantity.unit, lossless, settled, datatype, mapping-quantity, [[The unit display text.]])
* insert UnmappedModelElement(DV_QUANTITY.magnitude-status, [[SimpleQuantity forbids comparator; equality is implicit, other statuses are not carried; settled. See mapping-quantity.]])
* insert UnmappedModelElement(DV_QUANTITY.normal-range, [[No reference-range home in the SimpleQuantity mapping; settled. See mapping-quantity.]])
* insert UnmappedModelElement(DV_QUANTITY.other-reference-ranges, [[No reference-range home in the SimpleQuantity mapping; settled. See mapping-quantity.]])
* insert UnmappedModelElement(DV_QUANTITY.normal-status, [[No normal-status home in the SimpleQuantity mapping; settled. See mapping-quantity.]])

* insert OpenEHRModelGroup(DV-QUANTITY, MoneyQuantity)
* insert ModelElement(DV_QUANTITY, Quantity, lossy, open, datatype, mapping-quantity, [[MoneyQuantity is a currency-constrained Quantity and follows that correspondence, including unsupported approximation and ambiguous percentage accuracy; it is not Money.]])
* insert ModelCondition([[The units represent an ISO 4217 currency as required by the MoneyQuantity profile.]])
* insert ModelElement(DV_QUANTITY.magnitude, Quantity.value, lossless, settled, datatype, mapping-quantity, [[The monetary magnitude in the constrained Quantity representation.]])
* insert ModelElement(DV_QUANTITY.units, Quantity.code, lossless, settled, datatype, mapping-quantity, [[The ISO 4217 code in the currency-constrained Quantity.]])
* insert ModelElement(DV_QUANTITY.units-system, Quantity.system, lossless, settled, datatype, mapping-quantity, [[The system is urn:iso:std:iso:4217, not a UCUM default.]])
* insert ModelElement(DV_QUANTITY.units-display-name, Quantity.unit, lossless, settled, datatype, mapping-quantity, [[The currency display text.]])
* insert ModelElement(DV_QUANTITY.magnitude-status, Quantity.comparator, lossless, settled, datatype, mapping-quantity, [[Unlike Money, MoneyQuantity allows the Quantity comparator correspondence, excluding ~.]])

* insert OpenEHRModelGroup(DV-ORDINAL, Observation)
* insert ModelElement(DV_ORDINAL, Observation.component, lossless, open, archetype, mapping-quantity, [[A surrounding archetype arranges the coded symbol and integer score as components; this is not a standalone datatype conversion.]])
* insert ModelElement(DV_ORDINAL.symbol, Observation.component.value[x], lossless, settled, archetype, mapping-quantity, [[The CodeableConcept alternative of component.value[x], delegating to DV_CODED_TEXT.]])
* insert ModelCondition([[Component value is CodeableConcept, representing the symbol.]])
* insert ModelElement(DV_ORDINAL.value, Observation.component.value[x], lossless, settled, archetype, mapping-quantity, [[The integer alternative of component.value[x], representing the separate score component.]])
* insert ModelCondition([[Component value is integer, representing the score.]])
* insert ModelElement(DV_ORDINAL.normal-range, Observation.referenceRange, lossless, settled, archetype, mapping-quantity, [[Normal and other reference ranges follow the shared ordered-value pattern.]])
* insert ModelElement(DV_ORDINAL.other-reference-ranges, Observation.referenceRange, lossless, settled, archetype, mapping-quantity, [[The inherited other reference ranges share the normal-range row; their meanings distinguish them from type normal.]])
* insert ModelElement(DV_ORDINAL.normal-status, Observation.interpretation, lossless, open, archetype, mapping-quantity, [[Normal status follows the shared ordered-value pattern.]])
* insert OpenEHRModelGroup(DV-ORDINAL, QuestionnaireResponse)
* insert ModelElement(DV_ORDINAL.symbol, QuestionnaireResponse.item.answer.value[x], lossless, settled, archetype, mapping-quantity, [[The Coding alternative of answer.value[x], not a fabricated valueCoding snapshot ID.]])
* insert ModelCondition([[The ordinal symbol answers a questionnaire item and the answer type is Coding.]])
* insert OpenEHRExtensionGroup(DV-ORDINAL, itemWeight)
* insert ModelElement(DV_ORDINAL.value, Extension.value[x], lossless, settled, archetype, mapping-quantity, [[An alternative score representation: itemWeight on the component's coded symbol, not a second score emitted automatically.]])

* insert OpenEHRModelGroup(DV-SCALE, Observation)
* insert ModelElement(DV_SCALE, Observation.component, lossless, open, archetype, mapping-quantity, [[The archetype arranges the coded symbol and real-valued score; a scale score is not necessarily an integer.]])
* insert ModelElement(DV_SCALE.symbol, Observation.component.value[x], lossless, settled, archetype, mapping-quantity, [[The CodeableConcept alternative represents the symbol.]])
* insert ModelCondition([[Component value is CodeableConcept, representing the symbol.]])
* insert ModelElement(DV_SCALE.value, Observation.component.value[x], lossless, settled, archetype, mapping-quantity, [[The Quantity alternative represents the real-valued score.]])
* insert ModelCondition([[Component value is Quantity, representing the score.]])
* insert ModelElement(DV_SCALE.normal-range, Observation.referenceRange, lossless, settled, archetype, mapping-quantity, [[The shared ordered-value reference-range pattern.]])
* insert ModelElement(DV_SCALE.other-reference-ranges, Observation.referenceRange, lossless, settled, archetype, mapping-quantity, [[The inherited other reference ranges share that row and carry their meanings as referenceRange.type.]])
* insert ModelElement(DV_SCALE.normal-status, Observation.interpretation, lossless, open, archetype, mapping-quantity, [[The shared ordered-value normal-status pattern.]])
* insert OpenEHRExtensionGroup(DV-SCALE, itemWeight)
* insert ModelElement(DV_SCALE.value, Extension.value[x], lossless, settled, archetype, mapping-quantity, [[Alternative: carry the score as itemWeight on the coded symbol.]])

* insert OpenEHRModelGroup(CODE-PHRASE, Coding)
* insert ModelElement(CODE_PHRASE, Coding, lossy, open, datatype, mapping-coded, [[Codes invalid under FHIR's whitespace rules are refused. Version joining/splitting remains unresolved; these maps do not adopt a format.]])
* insert ModelElement(CODE_PHRASE.terminology-id, Coding.system, lossless, open, datatype, mapping-coded, [[The opaque terminology identifier is carried as described; these model maps do not resolve the terminology URI/version policy.]])
* insert ModelElement(CODE_PHRASE.code-string, Coding.code, lossless, open, datatype, mapping-coded, [[Only codes satisfying FHIR's code whitespace constraints map; invalid source codes produce no Coding.]])
* insert ModelElement(CODE_PHRASE.preferred-term, Coding.display, lossless, settled, datatype, mapping-coded, [[The preferred term becomes the display text.]])
* insert OpenEHRModelGroup(DV-CODED-TEXT, CodeableConcept)
* insert ModelElement(DV_CODED_TEXT, CodeableConcept, lossy, open, datatype, mapping-coded, [[The defining-code distinction among multiple unmarked codings, term-mapping match and term-mapping purpose are not preserved.]])
* insert ModelElement(DV_CODED_TEXT.value, CodeableConcept.text, lossless, settled, datatype, mapping-coded, [[Free text or text differing from the defining code's rubric.]])
* insert ModelElement(DV_CODED_TEXT.defining-code, CodeableConcept.coding, lossy, open, datatype, mapping-coded, [[The defining CODE_PHRASE becomes a Coding. Its identity is retained with a single coding or external defining-code context; with several unmarked codings the defining distinction is lost. Array position is not a marker.]])
* insert ModelElement(DV_CODED_TEXT.mappings, CodeableConcept.coding, lossy, open, datatype, mapping-coded, [[Additional codings lose TERM_MAPPING.match and purpose; composed CODE_PHRASE losses remain visible.]])
* insert OpenEHRModelGroup(DV-CODED-TEXT, Coding)
* insert ModelElement(DV_CODED_TEXT, Coding, lossy, open, datatype, mapping-coded, [[Bare Coding is an alternative, not a replacement for a multi-coding CodeableConcept; mapping relationships and text distinctions need the conditions in the table.]])
* insert ModelCondition([[One coding, and value equals the defining code's rubric in the stated language.]])
* insert ModelElement(DV_CODED_TEXT.value, Coding.display, lossless, settled, datatype, mapping-coded, [[The value can be the display only when it equals the defining code's rubric in the stated language.]])
* insert ModelCondition([[Bare Coding representation with the value equal to the rubric.]])

* insert OpenEHRModelGroup(TERM-MAPPING, Coding)
* insert ModelElement(TERM_MAPPING, Coding, lossy, open, datatype, mapping-coded, [[Only the mapped term is carried; match and purpose have no adopted instance representation.]])
* insert ModelElement(TERM_MAPPING.target, Coding.code, lossless, settled, datatype, mapping-coded, [[The target CODE_PHRASE supplies Coding.code; system and display are handled by the delegated CODE_PHRASE correspondence, not by copying the composite into a scalar.]])
* insert UnmappedModelElement(TERM_MAPPING.match, [[No instance field carries mapping equivalence; settled. See mapping-coded.]])
* insert UnmappedModelElement(TERM_MAPPING.purpose, [[No representation has been adopted; open, working-group/openehr-modelling. See mapping-coded.]])

* insert OpenEHRModelGroup(ELEMENT, Observation)
* insert ModelElement(ELEMENT.null-flavour, Observation.dataAbsentReason, lossless, settled, archetype, mapping-coded, [[The null-flavour container maps here when Observation.value[x] is absent; the code itself uses the separate, potentially lossy terminology maps.]])
* insert ModelCondition([[The absent value is Observation.value[x].]])
* insert OpenEHRExtensionGroup(ELEMENT, data-absent-reason)
* insert ModelElement(ELEMENT.null-flavour, Extension.value[x], lossless, settled, archetype, mapping-coded, [[For another absent element, translate the null-flavour code into the data-absent-reason extension's code value. Text/rubric handling remains contextual.]])
* insert ModelCondition([[The absent value is not Observation.value[x].]])
* insert OpenEHRExtensionGroup(ELEMENT, iso21090-nullFlavor)
* insert UnmappedModelElement(ELEMENT.null-flavour, [[The RI does not emit this extension; planned terminology maps do not implement structural support; open, openehr-modelling. See mapping-coded.]])

* insert OpenEHRModelGroup(DV-TEXT, string)
* insert ModelElement(DV_TEXT, string, lossy, open, datatype, mapping-textual, [[Encoding, deprecated hyperlink and term mappings are not carried; formatting distinctions and language qualifiers can be lost.]])
* insert ModelElement(DV_TEXT.value, string.value, lossless, settled, datatype, mapping-textual, [[A nonempty value within FHIR's string limits. FHIR whitespace and size constraints still apply; do not silently truncate oversized content.]])
* insert UnmappedModelElement(DV_TEXT.encoding, [[Original character encoding is not carried; sender converts to UTF-8; settled. See mapping-textual.]])
* insert UnmappedModelElement(DV_TEXT.hyperlink, [[Deprecated hyperlink has no field correspondence; optional markdown folding is a value transformation; settled. See mapping-textual.]])
* insert UnmappedModelElement(DV_TEXT.mappings, [[Not carried by the string mapping; use the coded-text correspondence when applicable; settled. See mapping-textual.]])
* insert OpenEHRModelGroup(DV-TEXT, markdown)
* insert ModelElement(DV_TEXT, markdown, lossy, open, datatype, mapping-textual, [[Markdown is the contextual target for markdown-formatted text; encoding, mappings and language/formatting distinctions retain the table's losses.]])
* insert ModelCondition([[The FHIR element is typed markdown and formatting is markdown.]])
* insert ModelElement(DV_TEXT.value, markdown.value, lossless, settled, datatype, mapping-textual, [[The text content is carried in the markdown primitive.]])
* insert ModelCondition([[The FHIR element is typed markdown and formatting is markdown.]])
* insert ModelElement(DV_TEXT.formatting, markdown, lossless, open, datatype, mapping-textual, [[The markdown datatype itself represents the markdown formatting choice, not a second primitive value.]])
* insert ModelCondition([[The FHIR element is typed markdown and formatting is markdown.]])
* insert OpenEHRExtensionGroup(DV-TEXT, rendering-markdown)
* insert ModelElement(DV_TEXT.formatting, Extension.value[x], lossy, open, datatype, mapping-textual, [[Markdown rendering is carried on a string; plain/plain_no_newlines and legacy CSS distinctions have no FHIR representation.]])
* insert ModelCondition([[Markdown formatting is carried by the rendering-markdown extension rather than a native markdown element.]])
* insert OpenEHRExtensionGroup(DV-TEXT, language)
* insert ModelElement(DV_TEXT.language, Extension.value[x], lossy, open, datatype, mapping-textual, [[Only the language tag is carried; CODE_PHRASE.terminology_id is lost.]])
* insert OpenEHRModelGroup(DV-PARAGRAPH, markdown)
* insert UnmappedModelElement(DV_PARAGRAPH, [[No mapping agreed for the deprecated paragraph type; not-discussed, working-group. See mapping-textual.]])
* insert UnmappedModelElement(DV_PARAGRAPH.items, [[No item conversion has been agreed; not-discussed, working-group. See mapping-textual.]])
* insert OpenEHRModelGroup(DV-PARAGRAPH, string)
* insert UnmappedModelElement(DV_PARAGRAPH, [[No mapping agreed; not-discussed, working-group. See mapping-textual.]])

* insert OpenEHRModelGroup(DV-IDENTIFIER, Identifier)
* insert ModelElement(DV_IDENTIFIER, Identifier, lossy, open, datatype, mapping-reference, [[FHIR use/period have no datatype counterpart; issuer URI policy is open. The reverse type/assigner correspondences lose structure.]])
* insert ModelElement(DV_IDENTIFIER.id, Identifier.value, lossless, settled, datatype, mapping-reference, [[The identifier value.]])
* insert ModelElement(DV_IDENTIFIER.issuer, Identifier.system, lossless, open, datatype, mapping-reference, [[The table's provisional issuer-to-URI convention; no URI-prefix policy is settled by this map.]])
* insert ModelElement(DV_IDENTIFIER.type, Identifier.type, lossless, open, datatype, mapping-reference, [[The system::value convention becomes one coding; splitting uses the last occurrence of ::.]])
* insert ModelElement(DV_IDENTIFIER.assigner, Identifier.assigner, lossless, open, datatype, mapping-reference, [[The assigner string becomes the identifier within a Reference under the documented convention.]])

* insert OpenEHRModelGroup(DV-URI, uri)
* insert ModelElement(DV_URI, uri, lossy, open, datatype, mapping-reference, [[A legal URI maps directly; percent-encoding a plain-text URI loses its original readable form.]])
* insert ModelElement(DV_URI.value, uri.value, lossy, open, datatype, mapping-reference, [[A conformant RFC 3986 URI is carried unchanged and losslessly. A plain-text URI needs encoding of forbidden characters and loses its original readable form; existing escapes remain unchanged.]])
* insert OpenEHRModelGroup(DV-URI, url)
* insert ModelElement(DV_URI, url, lossy, open, datatype, mapping-reference, [[Only a resolvable address belongs in url; plain-text URI normalization can lose the original readable form.]])
* insert ModelCondition([[The target element is typed url and the value is a resolvable address.]])
* insert ModelElement(DV_URI.value, url.value, lossless, open, datatype, mapping-reference, [[A URI already satisfying the target url constraints.]])
* insert OpenEHRModelGroup(DV-URI, oid)
* insert ModelElement(DV_URI.value, oid.value, lossless, open, datatype, mapping-reference, [[Only a urn:oid: URI maps; values outside the required form have no mapping.]])
* insert ModelCondition([[The target is typed oid and the source is a conforming urn:oid: URI.]])
* insert OpenEHRModelGroup(DV-URI, uuid)
* insert ModelElement(DV_URI.value, uuid.value, lossless, open, datatype, mapping-reference, [[Only a lowercase urn:uuid: URI maps; an uppercase UUID is not silently repaired.]])
* insert ModelCondition([[The target is typed uuid and the source has the required lowercase urn:uuid: form.]])
* insert OpenEHRModelGroup(DV-URI, canonical)
* insert ModelElement(DV_URI.value, canonical.value, lossless, open, datatype, mapping-reference, [[A resource canonical URL with an optional version suffix; an arbitrary URI containing | is not necessarily a canonical reference.]])
* insert ModelCondition([[The target is typed canonical and the value identifies a resource canonically.]])
* insert OpenEHRModelGroup(DV-EHR-URI, uri)
* insert ModelElement(DV_EHR_URI.value, uri.value, lossless, open, datatype, mapping-reference, [[The ehr: URI is carried opaquely; no FHIR resolution semantics are invented.]])

* insert OpenEHRModelGroup(LINK, Reference)
* insert ModelElement(LINK, Reference, lossy, open, datatype, mapping-reference, [[A bare Reference loses LINK.type and metadata on the DV_TEXT meaning. Resolving a record target requires external conversion context.]])
* insert ModelElement(LINK.target, Reference.identifier, lossless, open, datatype, mapping-reference, [[Carry the unresolved URI as an Identifier with system urn:ietf:rfc:3986; do not pretend that an ehr: URI locates a FHIR resource.]])
* insert ModelCondition([[The target has not been resolved to a FHIR resource.]])
* insert ModelTarget(Reference.reference, lossless, open, archetype, mapping-reference, [[A resolved target uses the converted FHIR resource's location, with targetElement/targetPath only if sub-element granularity is genuinely needed.]])
* insert ModelCondition([[External conversion context resolves the target to a FHIR resource.]])
* insert ModelElement(LINK.meaning, Reference.display, lossy, open, datatype, mapping-reference, [[Only DV_TEXT.value participates; formatting, encoding, hyperlink and mappings are not preserved here.]])
* insert OpenEHRModelGroup(LINK, CodeableReference)
* insert ModelElement(LINK.type, CodeableReference.concept, lossy, open, archetype, mapping-reference, [[Only the link-type DV_TEXT value participates. A bare Reference has no concept; choosing CodeableReference needs archetype context.]])
* insert OpenEHRModelGroup(PARTY-IDENTIFIED, Reference)
* insert UnmappedModelElement(PARTY_IDENTIFIED, [[External party reference mapping is not decided by this guide; open, openehr-modelling. See mapping-reference.]])

* insert OpenEHRModelGroup(DV-DATE, date)
* insert ModelElement(DV_DATE, date, lossless, settled, datatype, mapping-temporal, [[Expand compact lexical forms; preserve partial date precision by truncation, never padding.]])
* insert ModelElement(DV_DATE.value, date.value, lossless, settled, datatype, mapping-temporal, [[For example 202604 becomes 2026-04, not a fabricated first day.]])
* insert OpenEHRModelGroup(DV-DATE, dateTime)
* insert ModelElement(DV_DATE.value, dateTime.value, lossless, settled, datatype, mapping-temporal, [[A date-only dateTime, not an invented time of day.]])
* insert ModelCondition([[The FHIR element is typed dateTime and carries only a date.]])
* insert OpenEHRModelGroup(DV-TIME, time)
* insert ModelElement(DV_TIME, time, lossy, open, datatype, mapping-temporal, [[Offsets have no home; completing hour/minute precision loses the source precision.]])
* insert ModelElement(DV_TIME.value, time.value, lossy, open, datatype, mapping-temporal, [[Seconds-precision values without an offset map losslessly. Hour/minute-only forms are completed to seconds and lose the original precision. Any UTC offset is lost; use dateTime when it is clinically significant.]])
* insert OpenEHRModelGroup(DV-DATE-TIME, dateTime)
* insert ModelElement(DV_DATE_TIME, dateTime, lossy, open, datatype, mapping-temporal, [[Hour/minute completion loses precision, no-offset times are refused, and temporal accuracy/status have no primitive home.]])
* insert ModelElement(DV_DATE_TIME.value, dateTime.value, lossy, settled, datatype, mapping-temporal, [[Expand compact dates and preserve supported partial dates losslessly. Times already stating seconds map losslessly; hour/minute precision is completed to seconds and loses the stated precision. A time without a source/context offset is refused, never given a fabricated Z.]])
* insert ModelCondition([[A partial date, or a time with an actual offset supplied by the source or context.]])
* insert UnmappedModelElement(DV_DATE_TIME.accuracy, [[Temporal accuracy has no primitive home; settled. See mapping-temporal.]])
* insert UnmappedModelElement(DV_DATE_TIME.magnitude-status, [[Temporal magnitude status has no primitive home; settled. See mapping-temporal.]])
* insert OpenEHRModelGroup(DV-DATE-TIME, instant)
* insert ModelElement(DV_DATE_TIME.value, instant.value, lossless, settled, datatype, mapping-temporal, [[An instant requires the full date/time and an offset; partial values have no instant correspondence.]])
* insert ModelCondition([[The target is typed instant and the source is fully precise with an offset.]])

* insert OpenEHRModelGroup(DV-DURATION, Duration)
* insert ModelElement(DV_DURATION, Duration, lossy, open, datatype, mapping-temporal, [[Only a single ISO component maps directly; multi-component durations are refused, approximate status has no R5 home, and reference information needs Observation context.]])
* insert ModelElement(DV_DURATION.value, Duration.value, lossless, open, datatype, mapping-temporal, [[Parse the single ISO component into a magnitude; the sign precedes P. Calendar years/months round-trip lexically but are not interchangeable with UCUM units in date arithmetic.]])
* insert ModelCondition([[One supported ISO component, not a multi-component duration.]])
* insert ModelTarget(Duration.code, lossless, settled, datatype, mapping-temporal, [[The designator inside the same ISO string supplies a, mo, wk, d, h, min or s; Duration.system is UCUM.]])
* insert ModelElement(DV_DURATION.magnitude-status, Duration.comparator, lossless, settled, datatype, mapping-temporal, [[The Quantity comparator correspondence; equality means absence and ~ is not mapped.]])
* insert OpenEHRExtensionGroup(DV-DURATION, quantity-accuracy)
* insert ModelElement(DV_DURATION.accuracy, Extension.value[x], lossless, open, datatype, mapping-temporal, [[The accuracy Quantity carries relative % or the duration's own time unit.]])
* insert ModelElement(DV_DURATION.accuracy-is-percent, Extension.value[x].code, lossless, open, datatype, mapping-temporal, [[As stated in the accuracy row, the accuracy unit encodes whether the accuracy is relative; a duration's own unit is never %.]])
* insert OpenEHRModelGroup(DV-DURATION, Observation)
* insert ModelElement(DV_DURATION.normal-range, Observation.referenceRange, lossless, settled, archetype, mapping-temporal, [[The normal range has type normal.]])
* insert ModelElement(DV_DURATION.other-reference-ranges, Observation.referenceRange, lossless, settled, archetype, mapping-temporal, [[Other reference-range meanings supply type.]])
* insert ModelElement(DV_DURATION.normal-status, Observation.interpretation, lossless, open, archetype, mapping-temporal, [[The shared ordered-value interpretation correspondence.]])
* insert OpenEHRModelGroup(DV-DURATION, Timing)
* insert UnmappedModelElement(DV_DURATION.value, [[Complex scheduling is deferred to archetype-level work; open, working-group. See mapping-temporal.]])
* insert OpenEHRModelGroup(DV-GENERAL-TIME-SPECIFICATION, Timing)
* insert UnmappedModelElement(DV_GENERAL_TIME_SPECIFICATION, [[No mapping agreed; not-discussed, working-group. See mapping-temporal.]])
* insert UnmappedModelElement(DV_GENERAL_TIME_SPECIFICATION.value, [[The GTS-based syntax has not been mapped; not-discussed, working-group. See mapping-temporal.]])
* insert OpenEHRModelGroup(DV-PERIODIC-TIME-SPECIFICATION, Timing)
* insert UnmappedModelElement(DV_PERIODIC_TIME_SPECIFICATION, [[No mapping agreed; not-discussed, working-group. See mapping-temporal.]])
* insert UnmappedModelElement(DV_PERIODIC_TIME_SPECIFICATION.value, [[The periodic syntax has not been mapped; not-discussed, working-group. See mapping-temporal.]])

* insert OpenEHRModelGroup(DV-MULTIMEDIA, Attachment)
* insert ModelElement(DV_MULTIMEDIA, Attachment, lossy, open, datatype, mapping-other, [[Compression metadata and some language information are lost; decompression can change bytes/size and invalidate hashes. Thumbnail losses compose with the parent.]])
* insert ModelElement(DV_MULTIMEDIA.data, Attachment.data, lossy, open, datatype, mapping-other, [[Uncompressed inline bytes map losslessly. Supported gzip/zlib/deflate inline content is decompressed and loses its original compressed bytes; undecompressible or externally referenced compressed content is refused.]])
* insert ModelElement(DV_MULTIMEDIA.uri, Attachment.url, lossy, open, datatype, mapping-other, [[A valid URL resolving to the content maps losslessly. Percent-encoding a plain-text source URI loses its original readable form.]])
* insert ModelElement(DV_MULTIMEDIA.media-type, Attachment.contentType, lossless, open, datatype, mapping-other, [[The IANA MIME type, with charset folded in separately.]])
* insert ModelElement(DV_MULTIMEDIA.charset, Attachment.contentType, lossless, settled, datatype, mapping-other, [[The charset parameter within contentType, not a fabricated Attachment.charset element.]])
* insert ModelElement(DV_MULTIMEDIA.size, Attachment.size, lossy, open, datatype, mapping-other, [[The 32-bit size maps losslessly to integer64, serialized as a JSON string; zero is a value. If decompression changes the size, the decompressed byte count replaces it and the original stated number is lost.]])
* insert ModelElement(DV_MULTIMEDIA.alternate-text, Attachment.title, lossless, open, datatype, mapping-other, [[Display text used in place of the content.]])
* insert ModelElement(DV_MULTIMEDIA.integrity-check, Attachment.hash, lossless, open, datatype, mapping-other, [[Attachment.hash is SHA-1 only. A hash with no stated algorithm, or one invalidated by decompression, is not carried.]])
* insert ModelCondition([[Algorithm is SHA-1 and the content was not decompressed.]])
* insert ModelElement(DV_MULTIMEDIA.integrity-check-algorithm, Attachment.hash, lossless, open, datatype, mapping-other, [[Selecting Attachment.hash entails SHA-1; the algorithm is not encoded as literal hash bytes.]])
* insert ModelCondition([[Algorithm is SHA-1 and the content was not decompressed.]])
* insert ModelElement(DV_MULTIMEDIA.language, Attachment.language, lossy, open, datatype, mapping-other, [[The language tag survives but its CODE_PHRASE terminology identifier does not.]])
* insert UnmappedModelElement(DV_MULTIMEDIA.compression-algorithm, [[No Attachment compression field; open, FHIR-56003. See mapping-other.]])
* insert OpenEHRExtensionGroup(DV-MULTIMEDIA, alternate-hash)
* insert ModelElement(DV_MULTIMEDIA.integrity-check, Extension.extension:hash.value[x], lossless, open, datatype, mapping-other, [[A non-SHA-1 hash uses the hash slice, encoded in the guide's documented base64 form.]])
* insert ModelCondition([[A known non-SHA-1 algorithm and no decompression.]])
* insert ModelElement(DV_MULTIMEDIA.integrity-check-algorithm, Extension.extension:algorithm.value[x], lossless, open, datatype, mapping-other, [[The algorithm slice states the known non-SHA-1 algorithm.]])
* insert ModelCondition([[A known non-SHA-1 algorithm and no decompression.]])
* insert OpenEHRExtensionGroup(DV-MULTIMEDIA, attachment-thumbnail)
* insert ModelElement(DV_MULTIMEDIA.thumbnail, Extension.value[x], lossless, open, datatype, mapping-other, [[The thumbnail becomes an Attachment in the extension and delegates to this multimedia mapping; failures and losses remain reported.]])
* insert ModelCondition([[The thumbnail itself is convertible; otherwise it is omitted and reported.]])

* insert OpenEHRModelGroup(DV-PARSABLE, string)
* insert ModelElement(DV_PARSABLE, string, lossy, open, datatype, mapping-other, [[The value can travel out, but the mandatory formalism and source charset have no string representation.]])
* insert ModelElement(DV_PARSABLE.value, string.value, lossless, open, datatype, mapping-other, [[Only a nonempty conforming string maps; an empty parsable value cannot become a valid FHIR string.]])
* insert UnmappedModelElement(DV_PARSABLE.formalism, [[Mandatory formalism has no supported string field/extension; open, session:dv-parsable-formalism. See mapping-other.]])
* insert UnmappedModelElement(DV_PARSABLE.charset, [[Original charset is not carried; UTF-8 conversion precedes mapping; settled. See mapping-other.]])
* insert OpenEHRExtensionGroup(DV-PARSABLE, language)
* insert ModelElement(DV_PARSABLE.language, Extension.value[x], lossy, open, datatype, mapping-other, [[Only the language tag is carried; the terminology identifier is lost.]])
* insert OpenEHRModelGroup(DV-STATE, CodeableConcept)
* insert ModelElement(DV_STATE, CodeableConcept, lossy, open, datatype, mapping-other, [[State-machine terminality is not carried. The coded value also loses defining-code markers and term-mapping match/purpose through its composed mapping.]])
* insert ModelElement(DV_STATE.value, CodeableConcept, lossy, open, datatype, mapping-other, [[Delegate to DV_CODED_TEXT and retain all of that correspondence's losses.]])
* insert UnmappedModelElement(DV_STATE.is-terminal, [[No CodeableConcept element states terminality; open, working-group. See mapping-other.]])
